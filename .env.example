# Copy to .env.local for local dev; enter the same keys by hand in the Render dashboard.
# Never commit real values.

# App. APP_BASE_URL is local only: on Render the app falls back to RENDER_EXTERNAL_URL.
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=info
NEXT_TELEMETRY_DISABLED=1

# Neon (pooled connection string, AWS us-east-2)
DATABASE_URL=

# Meta Model API (OpenAI-compatible base URL)
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
# Model IDs from https://dev.meta.ai/docs/pricing-rate-limits. Never a -contributor model: Meta trains on those prompts.
META_MODEL_SPARK=muse-spark-1.3
META_MODEL_WONDER=muse-wonder-1.0

# Signs negotiation counter-offers (HMAC). Generate: openssl rand -hex 32
NEGOTIATION_SIGNING_SECRET=

# WhatsApp Cloud API (S6b), from the Meta app's WhatsApp product: set all four or none. The app
# secret signs webhook calls, the verify token is one you choose when you subscribe the webhook
# (Callback URL <base>/api/whatsapp), the access token and phone number ID are the test number's.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com/v23.0

# Local and CI only: a disposable-database server for integration tests. Never Neon.
# Example: postgres://postgres@127.0.0.1:5432/postgres
TEST_DATABASE_URL=
