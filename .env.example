# Copy to .env.local for local dev; enter the same keys by hand in the Render dashboard.
# Never commit real values.

# App
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=info
NEXT_TELEMETRY_DISABLED=1

# Neon (pooled connection string, AWS us-east-2)
DATABASE_URL=

# Meta Model API (OpenAI-compatible base URL)
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
# Exact model ID strings from the Meta docs
META_MODEL_SPARK=
META_MODEL_WONDER=

# OpenRouter, DeepSeek eval baseline only (S9)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_DEEPSEEK=

# Signs negotiation counter-offers (HMAC). Generate: openssl rand -hex 32
NEGOTIATION_SIGNING_SECRET=
