    { "id": "short", "backgroundParties": 2, "minPoolCovers": 8, "capacityCovers": 8 },
    { "id": "full", "backgroundParties": 4, "minPoolCovers": 8, "capacityCovers": 8 },
    { "id": "solo", "backgroundParties": 0, "minPoolCovers": 2, "capacityCovers": 8 }
  ],
  "reservationBpsOfOffer": [11000, 10000, 9900, 9800, 9700, 9600, 9400, 9200, 9000, 8800],
  "buyerGapBpsOfOffer": 200,
  "buyerLowballBpsOfOffer": 8000,
  "buyers": [
    { "id": "walk_one", "bids": "reservation once", "commit": "accepted only" },
    { "id": "open_take", "bids": "reservation minus one gap, once", "commit": "last signed counter at or below reservation" },
    { "id": "repeat_take", "bids": "reservation up to three times", "commit": "last signed counter at or below reservation" },
    { "id": "ladder_take", "bids": "reservation minus two gaps, minus one gap, then reservation", "commit": "last signed counter at or below reservation" },
    { "id": "lowball_take", "bids": "lowball price up to three times", "commit": "last signed counter at or below reservation" }
  ],
  "policies": [
    { "id": "fixed_max", "inputs": "public", "rule": "fixedConcession, unchanged: max(bid, previous - maxConcession)" },
    { "id": "always_hold", "inputs": "public", "rule": "previous" },
    { "id": "half_step", "inputs": "public", "rule": "max(bid, previous - floor(maxConcession / 2))" },
