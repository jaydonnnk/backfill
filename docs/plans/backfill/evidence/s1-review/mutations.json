[
  {
    "id": "env-contributor",
    "guard": "contributor model refused",
    "file": "src/env.ts",
    "from": "(value) => !value.endsWith(\"-contributor\")",
    "to": "(value) => true || !value.endsWith(\"-contributor\")"
  },
  {
    "id": "env-https",
    "guard": "META_BASE_URL https only",
    "file": "src/env.ts",
    "from": "(value) => value.startsWith(\"https://\")",
    "to": "(value) => true || value.startsWith(\"https://\")"
  },
  {
    "id": "env-postgres",
    "guard": "DATABASE_URL postgres scheme",
    "file": "src/env.ts",
    "from": "(value) => /^postgres(ql)?:\\/\\//.test(value)",
    "to": "(value) => true"
  },
  {
    "id": "env-secret-min",
    "guard": "signing secret >= 32",
    "file": "src/env.ts",
    "from": "z.string().min(32,",
    "to": "z.string().min(1,"
  },
  {
    "id": "env-base-url-order",
    "guard": "APP_BASE_URL wins over RENDER_EXTERNAL_URL",
    "file": "src/env.ts",
    "from": "APP_BASE_URL ?? RENDER_EXTERNAL_URL ?? LOCAL_BASE_URL",
    "to": "RENDER_EXTERNAL_URL ?? APP_BASE_URL ?? LOCAL_BASE_URL"
  },
  {
    "id": "env-no-echo",
    "guard": "config errors never echo values",
    "file": "src/env.ts",
    "from": "`${issue.path.join(\".\")}: ${issue.message}`",
    "to": "`${issue.path.join(\".\")}=${String(source[String(issue.path[0])])}: ${issue.message}`"
  },
  {
    "id": "env-platform-names",
    "guard": ".env.example lists exactly the names",
    "file": "src/env.ts",
    "from": ".filter((name) => !PLATFORM_NAMES.has(name))",
    "to": ".filter((name) => name.length > 0)"
  },
  {
    "id": "price-cached-rate",
    "guard": "cached tokens at cached rate",
    "file": "src/integrations/meta/pricing.ts",
    "from": "tokensCachedIn * price.cachedInput",
    "to": "tokensCachedIn * price.input"
  },
  {
    "id": "price-hasown",
    "guard": "prototype keys are not prices",
    "file": "src/integrations/meta/pricing.ts",
    "from": "return Object.hasOwn(PRICES_NANO_USD_PER_TOKEN, model);",
    "to": "return model in PRICES_NANO_USD_PER_TOKEN;"
  },
  {
    "id": "price-integer",
    "guard": "token counts integers",
    "file": "src/integrations/meta/pricing.ts",
    "from": "if (!Number.isSafeInteger(count) || count < 0)",
    "to": "if (count < 0)"
  },
  {
    "id": "price-cached-le-in",
    "guard": "cached <= input",
    "file": "src/integrations/meta/pricing.ts",
    "from": "if (tokensCachedIn > tokensIn) throw",
    "to": "if (false) throw"
  },
  {
    "id": "price-format-round",
    "guard": "formatUsd rounds half up",
    "file": "src/integrations/meta/pricing.ts",
    "from": "Math.floor((nanoUsd + 500) / 1000)",
    "to": "Math.floor(nanoUsd / 1000)"
  },
  {
    "id": "price-spark-input",
    "guard": "Spark input price",
    "file": "src/integrations/meta/pricing.ts",
    "from": "input: 1250,",
    "to": "input: 1251,"
  },
  {
    "id": "prov-429",
    "guard": "429 retried",
    "file": "src/integrations/meta/provider.ts",
    "from": "status === 429 || status >= 500",
    "to": "status >= 500"
  },
  {
    "id": "prov-500-boundary",
    "guard": "500 itself retried",
    "file": "src/integrations/meta/provider.ts",
    "from": "status === 429 || status >= 500",
    "to": "status === 429 || status > 500"
  },
  {
    "id": "prov-4xx-no-retry",
    "guard": "other 4xx not retried",
    "file": "src/integrations/meta/provider.ts",
    "from": "status === 429 || status >= 500",
    "to": "status >= 400"
  },
  {
    "id": "prov-unpriced",
    "guard": "unpriced model never sent",
    "file": "src/integrations/meta/provider.ts",
    "from": "if (!hasPrice(request.model)) throw new LlmError(`No price for model ${request.model}`, 0);",
    "to": ""
  },
  {
    "id": "prov-schema-key",
    "guard": "$schema stripped",
    "file": "src/integrations/meta/provider.ts",
    "from": "delete jsonSchema.$schema;",
    "to": ""
  },
  {
    "id": "prov-strict",
    "guard": "strict json_schema",
    "file": "src/integrations/meta/provider.ts",
    "from": "schema: jsonSchema, strict: true",
    "to": "schema: jsonSchema, strict: false"
  },
  {
    "id": "prov-feedback",
    "guard": "invalid reply fed back",
    "file": "src/integrations/meta/provider.ts",
    "from": "        messages.push(",
    "to": "        if (false) messages.push("
  },
  {
    "id": "prov-sum-cost",
    "guard": "failed attempts billed in total",
    "file": "src/integrations/meta/provider.ts",
    "from": "totalCost += cost;",
    "to": "totalCost = cost;"
  },
  {
    "id": "prov-output-limit",
    "guard": "output truncated to 4000",
    "file": "src/integrations/meta/provider.ts",
    "from": "content.slice(0, OUTPUT_LIMIT)",
    "to": "content"
  },
  {
    "id": "prov-empty",
    "guard": "null reply is invalid as empty",
    "file": "src/integrations/meta/provider.ts",
    "from": "if (content === null || content.trim() === \"\")",
    "to": "if (content !== null && content.trim() === \"\")"
  },
  {
    "id": "prov-timeout-msg",
    "guard": "timeout named",
    "file": "src/integrations/meta/provider.ts",
    "from": "name === \"TimeoutError\" ? `timed out after ${timeoutMs} ms` :",
    "to": ""
  },
  {
    "id": "prov-cached-usage",
    "guard": "cached tokens read from details",
    "file": "src/integrations/meta/provider.ts",
    "from": "raw.prompt_tokens_details?.cached_tokens ?? 0",
    "to": "0"
  },
  {
    "id": "log-pg-redact",
    "guard": "postgres URL redacted",
    "file": "src/lib/log.ts",
    "from": "[/postgres(?:ql)?:(?:\\\\?\\/){2}[^\\s\"'@]*@/gi, \"postgres://[redacted]@\"],",
    "to": ""
  },
  {
    "id": "log-bearer-redact",
    "guard": "bearer redacted",
    "file": "src/lib/log.ts",
    "from": "[/\\bBearer\\s+[A-Za-z0-9._~+/=-]+/gi, \"Bearer [redacted]\"],",
    "to": ""
  },
  {
    "id": "log-fields-redacted",
    "guard": "log() redacts string fields",
    "file": "src/lib/log.ts",
    "from": "safe[key] = typeof value === \"string\" ? redact(value) : value;",
    "to": "safe[key] = value;"
  },
  {
    "id": "log-sqlstate",
    "guard": "only SQLSTATE codes",
    "file": "src/lib/log.ts",
    "from": "/^[0-9A-Z]{5}$/.test(c)",
    "to": "c.length > 0"
  },
  {
    "id": "log-config-only",
    "guard": "only config messages pass",
    "file": "src/lib/log.ts",
    "from": "err instanceof Error && err.message.startsWith(\"Invalid web configuration:\") ? err.message : null",
    "to": "err instanceof Error ? err.message : null"
  },
  {
    "id": "db-extra-params",
    "guard": "unknown URL params refused",
    "file": "src/lib/db/client.ts",
    "from": "if (extra.length > 0) throw",
    "to": "if (false) throw"
  },
  {
    "id": "db-verify-full",
    "guard": "TLS verify-full off localhost",
    "file": "src/lib/db/client.ts",
    "from": "? false : \"verify-full\"",
    "to": "? false : (\"require\" as \"verify-full\")"
  },
  {
    "id": "db-libpq-strip",
    "guard": "libpq params stripped",
    "file": "src/lib/db/client.ts",
    "from": "for (const name of LIBPQ_ONLY) parsed.searchParams.delete(name);",
    "to": ""
  },
  {
    "id": "tracer-cooldown-edge",
    "guard": "cooldown ends exactly at 60 s",
    "file": "src/lib/tracer.ts",
    "from": "if (elapsed < TRACER_COOLDOWN_MS)",
    "to": "if (elapsed <= TRACER_COOLDOWN_MS)"
  },
  {
    "id": "tracer-cap-edge",
    "guard": "daily cap at 20",
    "file": "src/lib/tracer.ts",
    "from": "if (recent.count >= TRACER_DAILY_CAP)",
    "to": "if (recent.count > TRACER_DAILY_CAP)"
  },
  {
    "id": "llm-latest-ok",
    "guard": "latest skips failures",
    "file": "src/lib/llm-calls.ts",
    "from": "where(and(eq(llmCalls.purpose, purpose), eq(llmCalls.ok, true)))",
    "to": "where(eq(llmCalls.purpose, purpose))"
  },
  {
    "id": "llm-recent-since",
    "guard": "recent window bounded",
    "file": "src/lib/llm-calls.ts",
    "from": "where(and(eq(llmCalls.purpose, purpose), gte(llmCalls.createdAt, since)))",
    "to": "where(eq(llmCalls.purpose, purpose))"
  },
  {
    "id": "sql-cost-check",
    "guard": "cost >= 0 in DB",
    "file": "drizzle/0000_llm_calls.sql",
    "from": "CONSTRAINT \"llm_calls_cost_nonnegative\" CHECK (\"llm_calls\".\"cost_nano_usd\" >= 0),",
    "to": ""
  },
  {
    "id": "sql-latency-check",
    "guard": "latency >= 0 in DB",
    "file": "drizzle/0000_llm_calls.sql",
    "from": ",\n\tCONSTRAINT \"llm_calls_latency_nonnegative\" CHECK (\"llm_calls\".\"latency_ms\" >= 0)",
    "to": ""
  },
  {
    "id": "testdb-neon-refused",
    "guard": "tests never touch Neon",
    "file": "tests/support/db.ts",
    "from": "if (/neon\\.tech/i.test(new URL(baseUrl).hostname)) throw",
    "to": "if (false) throw"
  },
  {
    "id": "entry-realpath",
    "guard": "entrypoint through symlink",
    "file": "src/lib/entrypoint.ts",
    "from": "pathToFileURL(realpathSync(argv1)).href",
    "to": "pathToFileURL(argv1).href"
  },
  {
    "id": "press-lock",
    "guard": "simultaneous presses serialised by the advisory lock",
    "file": "src/lib/tracer-press.ts",
    "from": "if (!row?.locked) return \"busy\";",
    "to": "if (false) return \"busy\";"
  },
  {
    "id": "press-gate",
    "guard": "pressTracer applies the cooldown and cap",
    "file": "src/lib/tracer-press.ts",
    "from": "if (!gate.allowed) return gate.reason;",
    "to": ""
  },
  {
    "id": "press-xact-lock",
    "guard": "lock is transaction-scoped, held until commit",
    "file": "src/lib/tracer-press.ts",
    "from": "pg_try_advisory_xact_lock(${TRACER_LOCK_KEY})",
    "to": "pg_try_advisory_xact_lock(floor(random() * 1000000000)::bigint)"
  },
  {
    "id": "env-empty-unset",
    "guard": "empty env value counts as unset",
    "file": "src/env.ts",
    "from": ".filter(([, value]) => value !== \"\")",
    "to": ".filter(() => true)"
  },
  {
    "id": "health-config",
    "guard": "health reports config failure as config",
    "file": "src/app/api/health/route.ts",
    "from": "    if (fields.message) {",
    "to": "    if (false) {"
  }
]